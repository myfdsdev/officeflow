{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "receiver_id": {
      "type": "string",
      "description": "User ID of the receiver"
    },
    "receiver_email": {
      "type": "string",
      "description": "Email of the receiver"
    },
    "receiver_name": {
      "type": "string",
      "description": "Name of the receiver"
    },
    "message_text": {
      "type": "string",
      "description": "The message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read"
    },
    "is_edited": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been edited"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message is pinned"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message is deleted"
    },
    "deleted_by": {
      "type": "string",
      "description": "User ID who deleted the message"
    },
    "deleted_for_everyone": {
      "type": "boolean",
      "default": false,
      "description": "Whether deleted for everyone or just sender"
    },
    "muted_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user IDs who muted notifications"
    }
  },
  "required": [
    "sender_id",
    "sender_email",
    "receiver_id",
    "receiver_email",
    "message_text"
  ],
  "permissions": {
    "create": "auth.user.role == 'admin' || auth.user.role == 'user'",
    "read": "auth.user.id == record.sender_id || auth.user.id == record.receiver_id || auth.user.role == 'admin'",
    "update": "auth.user.id == record.sender_id || auth.user.id == record.receiver_id || auth.user.role == 'admin'",
    "delete": "auth.user.id == record.sender_id || auth.user.role == 'admin'",
    "list": "auth.user.role == 'admin' || auth.user.role == 'user'"
  }
}